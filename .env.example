# Neon Serverless PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@ep-something.aws.neon.tech/neondb?sslmode=require

# Admin Authentication
ADMIN_PASSWORD=change_this_to_a_secure_admin_password
JWT_SECRET=super_secret_jwt_random_signing_key_at_least_32_chars_long

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret